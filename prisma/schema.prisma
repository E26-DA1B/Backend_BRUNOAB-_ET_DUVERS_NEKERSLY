datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ETUDIANT
  FORMATEUR
  ADMIN
}

enum Level {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum EnrollmentStatus {
  ACTIF
  COMPLETE
  ABANDONNE
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        Role         @default(ETUDIANT)
  courses     Course[]     @relation("FormateurCours")
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String
  level       Level        @default(DEBUTANT)
  teacherId   String
  teacher     User         @relation("FormateurCours", fields: [teacherId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Lesson {
  id       String @id @default(uuid())
  title    String
  content  String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIF)
  progression Float            @default(0.0)
  scoreTotal  Int              @default(0)
  enrolledAt  DateTime         @default(now())

  @@unique([studentId, courseId])
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  scoreMax  Int
  lessonId  String
  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id               String   @id @default(uuid())
  externalId       String
  text             String
  correctAnswer    String
  incorrectAnswers String[] @default([])
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}